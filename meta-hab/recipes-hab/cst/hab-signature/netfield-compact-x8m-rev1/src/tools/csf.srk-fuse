#!/bin/bash

O=signed/srk-fuse
install -d ${O}

# Copy SRK fuse binary
cp ../crts/SRK_1_2_3_4_fuse.bin ${O}/hab-srk-fuse.bin

# Create HAB enable fuse binary
# NOTE: Be sure to use the correct byte order!
echo -n 0x02000000 | xxd -r | xxd -e | xxd -r > ${O}/hab-enable-fuse.bin

# Create u-boot command list to burn SRK fuses and enable the HAB
echo "# Burn the SRK fuses ..." > ${O}/hab-fuses.u-boot.sh
hexdump -e '/4 "0x"' -e '/4 "%X""\n"' ../crts/SRK_1_2_3_4_fuse.bin | awk 'BEGIN {BANK=5; ADDR=0;} { BANK+=(ADDR==0); $0="fuse prog "BANK" "ADDR" "$0; ADDR+=1 ; ADDR%=4;}1' >> ${O}/hab-fuses.u-boot.sh
echo "" >> ${O}/hab-fuses.u-boot.sh
echo "# Close the device ..." >> ${O}/hab-fuses.u-boot.sh
echo "fuse prog 1 3 0x02000000" >> ${O}/hab-fuses.u-boot.sh
chmod 755 ${O}/hab-fuses.u-boot.sh

# Create a linux command list to burn SRK fuses and enable the HAB
cat << EOF > ${O}/hab-fuses.linux.sh
#!/bin/sh

# Burn the SRK fuses ...
dd if=hab-srk-fuse.bin of=/sys/bus/nvmem/devices/imx-ocotp0/nvmem bs=4 seek=24

# Close the device ...
dd if=hab-enable-fuse.bin of=/sys/bus/nvmem/devices/imx-ocotp0/nvmem bs=4 seek=7
EOF
chmod 755 ${O}/hab-fuses.linux.sh
