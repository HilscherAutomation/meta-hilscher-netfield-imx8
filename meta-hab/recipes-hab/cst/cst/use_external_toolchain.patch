-ifeq ($(OSTYPE),linux64)
-LDOPTIONS += -L$(_OPENSSL_PATH)/lib64
-endif
-
 include ../build/make/$(TOOLCHAIN).mk
 include ../build/make/objects.mk
 
diff -aurN a/code/build/make/gcc.mk b/code/build/make/gcc.mk
--- a/code/build/make/gcc.mk	2024-01-02 19:13:36.000000000 +0100
+++ b/code/build/make/gcc.mk	2024-05-17 15:47:28.881299092 +0200
@@ -13,10 +13,10 @@
