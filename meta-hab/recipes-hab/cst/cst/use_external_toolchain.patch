diff -aurN a/code/build/make/binaries.mk b/code/build/make/binaries.mk
--- a/code/build/make/binaries.mk	2024-01-02 19:13:36.000000000 +0100
+++ b/code/build/make/binaries.mk	2024-05-17 16:04:48.568106224 +0200
@@ -37,13 +37,6 @@
 #===============================================================================
 CINCLUDES := $(foreach dir,$(VPATH),-I$(dir)/../hdr)
 
-# OpenSSL
-COPTIONS  += -I$(_OPENSSL_PATH)/include
