From d0b0d429840ff76b519e2b08451204bdf99fdb0c Mon Sep 17 00:00:00 2001
From: Frank Meisenbach <fmeisenbach@hilscher.com>
Date: Thu, 1 Apr 2021 17:13:05 +0200
Subject: [PATCH] cmd/mii: Fix wrong mii info message related to PHY status
 (speed, duplex ...).

---
 cmd/mii.c                 |  4 +--
 common/miiphyutil.c       | 35 ++++++++++++++++++++++++++
 drivers/net/phy/atheros.c | 53 +++++++++++++++++++++++++++++++++++++++
 include/phy.h             |  2 ++
 4 files changed, 91 insertions(+), 3 deletions(-)

diff --git a/cmd/mii.c b/cmd/mii.c
index 23ee1e6cfa..3b2b2b76e9 100644
--- a/cmd/mii.c
+++ b/cmd/mii.c
@@ -355,11 +355,9 @@ static int do_mii(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
 					"OUI = 0x%04X, "
 					"Model = 0x%02X, "
 					"Rev = 0x%02X, "
-					"%3dbase%s, %s\n",
+					"%3dMbps, %s\n",
 					j, oui, model, rev,
 					miiphy_speed (devname, j),
-					miiphy_is_1000base_x (devname, j)
-						? "X" : "T",
 					(miiphy_duplex (devname, j) == FULL)
 						? "FDX" : "HDX");
 			}
diff --git a/common/miiphyutil.c b/common/miiphyutil.c
index 2db067876e..82f8be87ba 100644
--- a/common/miiphyutil.c
+++ b/common/miiphyutil.c
@@ -390,6 +390,19 @@ int miiphy_reset(const char *devname, unsigned char addr)
 }
 #endif /* !PHYLIB */
 
+
+struct phy_device *get_phydev_by_devname(const char *devname, unsigned char addr)
+{
+	struct phy_device *phydev;
+	int i;
+
+	for (i = 0; i < PHY_MAX_ADDR; i++) {
+		if (current_mii->phymap[i]->addr == addr)
+			return current_mii->phymap[i];
+	}
+	return NULL;
+}
+
 /*****************************************************************************
  *
  * Determine the ethernet speed (10/100/1000).  Return 10 on error.
@@ -397,6 +410,17 @@ int miiphy_reset(const char *devname, unsigned char addr)
 int miiphy_speed(const char *devname, unsigned char addr)
 {
 	u16 bmcr, anlpar, adv;
+	struct phy_device *phydev = get_phydev_by_devname(devname, addr);
+
+	if (phydev) {
+		if (phydev->drv && phydev->drv->read_status) {
+			if (phydev->drv->read_status(phydev)) {
+				printf("PHY read_status");
+				goto miiphy_read_failed;
+			}
+			return phydev->speed;
+		}
+	}
 
 #if defined(CONFIG_PHY_GIGE)
 	u16 btsr;
@@ -455,6 +479,17 @@ miiphy_read_failed:
 int miiphy_duplex(const char *devname, unsigned char addr)
 {
 	u16 bmcr, anlpar, adv;
+	struct phy_device *phydev = get_phydev_by_devname(devname, addr);
+
+	if (phydev) {
+		if (phydev->drv && phydev->drv->read_status) {
+			if (phydev->drv->read_status(phydev)) {
+				printf("PHY read_status");
+				goto miiphy_read_failed;
+			}
+			return (phydev->duplex) ? FULL : HALF;
+		}
+	}
 
 #if defined(CONFIG_PHY_GIGE)
 	u16 btsr;
diff --git a/drivers/net/phy/atheros.c b/drivers/net/phy/atheros.c
index 50aa0d98c1..89a8e93f5d 100644
--- a/drivers/net/phy/atheros.c
+++ b/drivers/net/phy/atheros.c
@@ -210,6 +210,58 @@ static int ar803x_probe(struct phy_device *phydev)
 	return 0;
 }
 
+#define AT803X_SPECIFIC_STATUS			0x11
+#define AT803X_SS_SPEED_MASK			(3 << 14)
+#define AT803X_SS_SPEED_1000			(2 << 14)
+#define AT803X_SS_SPEED_100			(1 << 14)
+#define AT803X_SS_SPEED_10			(0 << 14)
+#define AT803X_SS_DUPLEX			BIT(13)
+#define AT803X_SS_SPEED_DUPLEX_RESOLVED	BIT(11)
+#define AT803X_SS_LINK				BIT(10)
+#define AT803X_SS_MDIX				BIT(6)
+static int ar803x_read_status(struct phy_device *phydev)
+{
+	struct at803x_priv *priv = phydev->priv;
+	u16 regval;
+
+	phydev->speed = SPEED_10;
+	phydev->duplex = DUPLEX_HALF;
+	phydev->link = 0;
+
+	/* Read the AT8035 PHY-Specific Status register, which indicates the
+	 * speed and duplex that the PHY is actually using, irrespective of
+	 * whether we are in autoneg mode or not.
+	 */
+	regval = phy_read(phydev, MDIO_DEVAD_NONE, AT803X_SPECIFIC_STATUS);
+
+	if (phydev->autoneg == AUTONEG_ENABLE) {
+		if ((regval & AT803X_SS_SPEED_DUPLEX_RESOLVED) == 0)
+			return 0;
+	}
+
+	if (regval & AT803X_SS_LINK)
+		phydev->link = 1;
+
+	switch (regval & AT803X_SS_SPEED_MASK) {
+		case AT803X_SS_SPEED_10:
+			phydev->speed = SPEED_10;
+			break;
+		case AT803X_SS_SPEED_100:
+			phydev->speed = SPEED_100;
+			break;
+		case AT803X_SS_SPEED_1000:
+			phydev->speed = SPEED_1000;
+			break;
+	}
+
+	if (regval & AT803X_SS_DUPLEX)
+		phydev->duplex = DUPLEX_FULL;
+	else
+		phydev->duplex = DUPLEX_HALF;
+
+	return 0;
+}
+
 static struct phy_driver AR8021_driver =  {
 	.name = "AR8021",
 	.uid = 0x4dd040,
@@ -229,6 +281,7 @@ static struct phy_driver AR8031_driver =  {
 	.config = ar8031_config,
 	.startup = genphy_startup,
 	.shutdown = genphy_shutdown,
+	.read_status = ar803x_read_status,
 };
 
 static struct phy_driver AR8035_driver =  {
diff --git a/include/phy.h b/include/phy.h
index b5de14cbfc..5ba39f2f96 100644
--- a/include/phy.h
+++ b/include/phy.h
@@ -118,6 +118,9 @@ struct phy_driver {
 	int (*write_mmd)(struct phy_device *phydev, int devad, int reg,
 			 u16 val);

+	/* Called to read phy specific status like speed, duplex, link ... */
+	int (*read_status)(struct phy_device *phydev);
+
 	struct list_head list;
 
 	/* driver private data */
-- 
2.17.1

