Use "u-boot,gpio-hog" which will limit the hogging to u-boot, so the gpio still can be exported under linux
diff --git a/drivers/gpio/gpio-uclass.c b/drivers/gpio/gpio-uclass.c
index 4a9b74e1ca1..4810e50cfb9 100644
--- a/drivers/gpio/gpio-uclass.c
+++ b/drivers/gpio/gpio-uclass.c
@@ -277,7 +277,7 @@ static int gpio_hog_probe(struct udevice *dev)
 	struct gpio_hog_priv *priv = dev_get_priv(dev);
 	int ret;
 
-	ret = gpio_dev_request_index(dev->parent, dev->name, "gpio-hog",
+	ret = gpio_dev_request_index(dev->parent, dev->name, "u-boot,gpio-hog",
 				     plat->val[0], plat->gpiod_flags,
 				     plat->val[1], &priv->gpiod);
 	if (ret < 0) {
@@ -1317,7 +1317,7 @@ static int gpio_post_bind(struct udevice *dev)
 
 	if (IS_ENABLED(CONFIG_GPIO_HOG)) {
 		dev_for_each_subnode(node, dev) {
-			if (ofnode_read_bool(node, "gpio-hog")) {
+			if (ofnode_read_bool(node, "u-boot,gpio-hog")) {
 				const char *name = ofnode_get_name(node);
 				int ret;
 
