From: Sebastian Doell <sdoell@hilscher.com>
Date: Wed, 17 Mar 2021 11:32:22 +0000
Subject: [PATCH] Increase phy auto negotiation timeout. Required for Gigabit
 link.

---
 include/configs/hilscher-ucm-imx8m-mini.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/include/configs/hilscher-ucm-imx8m-mini.h b/include/configs/hilscher-ucm-imx8m-mini.h
index 684a2d0888..69e3318cfc 100644
--- a/include/configs/hilscher-ucm-imx8m-mini.h
+++ b/include/configs/hilscher-ucm-imx8m-mini.h
@@ -3,6 +3,9 @@
 
 #define CONFIG_SYS_BOOTM_LEN 0x2000000
 
+/* GigaBit link requires longer autonegotiation */
+#define PHY_ANEG_TIMEOUT 10000
+
 /* Initial environment variables */
 #define HILSCHER_CONFIG_EXTRA_ENV_SETTINGS \
 	"loadbootscript="LOAD_BOOT_SCRIPT"\0" \
