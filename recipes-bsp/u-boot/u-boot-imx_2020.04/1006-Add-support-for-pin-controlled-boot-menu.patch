+static int init_boot_mode(void)
+{
+	int config_offset;
+	ofnode config_node;
+	struct gpio_desc gpio;
+	int cnt = 0;
+	char buf[10];
+	int ret;
+	unsigned long menu_duration = 1;
+	unsigned long menu_max = 10;
+
+	config_offset = fdt_path_offset(gd->fdt_blob, "/config");
+	config_node = offset_to_ofnode(config_offset);
+
+	ret = gpio_request_by_name_nodev(config_node, "u-boot,recovery-gpio", 0, &gpio, 0);
+	if (ret)
+		return ret;
+
+	env_set("boot_mode", "0");
+
+	/* check validity of variables to make sure setup always allows control by user */
+	menu_duration = env_get_ulong("menud", 10, 1);
+	menu_duration = (menu_duration > 5) ? 5 : menu_duration;
+	menu_max = env_get_ulong("menum", 10, 1);
+	menu_max = (menu_max < 1) ? 1 : menu_max;
+
+	/* check if user triggers menu pin */
+	while ( (dm_gpio_get_value(&gpio)) && (cnt < menu_max) ) {
+		/* We need to disable the LED once at the beginning, since it might be on */
+                /* already so add a delay as well, to be able to see first light signal.  */
+		if (cnt == 0) {
+			init_system_status_led(LEDST_OFF);
+			mdelay(1000);
+		}
+		/* increase and store menu counter */
+		cnt++;
+		sprintf(buf, "%d", cnt);
+
+		/* signal menu step via led */
+		env_set("boot_mode", buf);
+		init_system_status_led(LEDST_ON);
+		mdelay(100);
+		init_system_status_led(LEDST_OFF);
+
+		/* wait x second(s) to make sure user has a chance to unset pin after signalling */
+		mdelay(menu_duration*1000);
+	}
+	if (cnt >= menu_max) {
+		/* The last menu entry is always console. Some devices do not provide serial     */
+		/* console so we need to start netCONSOLE - this need to be done in a precommand */
+                /* to be able to stop autoboot, because of the pw-protection.                    */
+		init_system_status_led(LEDST_ON);
+		if ( env_get("menu_last_cmd") != NULL ) {
+			env_set("preboot", "run menu_last_cmd");
+		}
+	} else {
+		led_default_state();
+	}
+	return 0;
+}
+
+static void init_fastboot_variables()
+{
+	const char* model = NULL;
+	char cpu_name[64];
+	u32 cpurev = get_cpu_rev();
+
+	model = fdt_getprop(gd->fdt_blob, 0, "model", NULL);
+	snprintf(cpu_name, sizeof(cpu_name), "Freescale i.MX%s rev%d.%d",
+		get_imx_type((cpurev & 0xFF000) >> 12), (cpurev & 0x000F0) >> 4, (cpurev & 0x0000F) >> 0);
+
+	if(model)
+		env_set("board", model);
+	env_set("platform", cpu_name);
+	//env_set("fastboot.serialno", );
+#if defined(CONFIG_FIT_SIGNATURE) && !defined(CONFIG_LEGACY_IMAGE_FORMAT)
+	env_set("fastboot.secure", "yes");
+else
+	env_set("fastboot.secure", "no");
+#endif
+}
