 arch/arm64/configs/ucm-imx8m-mini.config | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/configs/ucm-imx8m-mini.config b/arch/arm64/configs/ucm-imx8m-mini.config
