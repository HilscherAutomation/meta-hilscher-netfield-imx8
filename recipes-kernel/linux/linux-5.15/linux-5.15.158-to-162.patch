 /*
diff --git a/net/ipv6/route.c b/net/ipv6/route.c
index 1ad78f0de044..3bc3a30363e1 100644
--- a/net/ipv6/route.c
+++ b/net/ipv6/route.c
@@ -87,7 +87,8 @@ struct dst_entry	*ip6_dst_check(struct dst_entry *dst, u32 cookie);
