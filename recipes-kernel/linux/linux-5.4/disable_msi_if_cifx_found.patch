This patch disables MSI when a cifX (netX100/500 based) device is found, as it does only support
legacy interrupts that don't work well on i.MX8 platforms

diff -aurN a/drivers/pci/quirks.c b/drivers/pci/quirks.c
--- a/drivers/pci/quirks.c	2021-08-05 13:57:09.564226473 +0200
+++ b/drivers/pci/quirks.c	2021-08-06 08:11:36.197532426 +0200
@@ -2531,6 +2531,7 @@
 DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_MARVELL_EXT, 0x2b42, quirk_disable_all_msi);
 DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_MARVELL_EXT, 0x2b43, quirk_disable_all_msi);
 DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_MARVELL_EXT, 0x2b44, quirk_disable_all_msi);
+DECLARE_PCI_FIXUP_EARLY(0x15cf, 0x0000, quirk_disable_all_msi);
 
 /* Disable MSI on chipsets that are known to not support it */
 static void quirk_disable_msi(struct pci_dev *dev)
